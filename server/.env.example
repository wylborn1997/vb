# 服务
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 微博开放平台
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
WEIBO_REDIRECT_URI=http://localhost:3000/auth/weibo/callback

# 发博监测（专用微博账号 Cookie，与粉丝 OAuth 账号分离）
WEIBO_MONITOR_COOKIE=

# 微信订阅消息模板 ID
WECHAT_SUBSCRIBE_TEMPLATE_ID=

# 数据库
DATABASE_PATH=./data/vb.db
