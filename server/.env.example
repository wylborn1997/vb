# 服务
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production

# 管理员 openid 白名单（逗号分隔；留空则任意登录用户可管理）
ADMIN_OPENIDS=

# 微信小程序（填写后启用真实 jscode2session；留空则开发环境 mock 登录）
WECHAT_APPID=
WECHAT_SECRET=

# 微博开放平台
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
WEIBO_REDIRECT_URI=http://localhost:3000/auth/weibo/callback

# 发博监测（二选一或都配；优先 access_token，失败回退 Cookie）
WEIBO_MONITOR_ACCESS_TOKEN=
WEIBO_MONITOR_COOKIE=

# 发评论时必填：服务器公网 IP（微博 API 要求 rip 参数）
WEIBO_SERVER_IP=127.0.0.1

# 微信订阅消息（公众平台申请模板后填入）
WECHAT_SUBSCRIBE_TEMPLATE_ID=
# 模板字段名需与公众平台模板一致，默认 thing1/thing2/time3
WECHAT_SUBSCRIBE_FIELD_STAR=thing1
WECHAT_SUBSCRIBE_FIELD_CONTENT=thing2
WECHAT_SUBSCRIBE_FIELD_TIME=time3

# 数据库
DATABASE_PATH=./data/vb.db
